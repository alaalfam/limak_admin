# Copy this file to .env and adjust values before running `docker compose up`

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=limak_wp
MYSQL_USER=limak
MYSQL_PASSWORD=change_me_user

# --- WordPress ---
WP_TABLE_PREFIX=limak_
WP_PORT=8080
WP_URL=http://localhost:8080

# Used only by the one-shot wp-cli bootstrap on first run
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_me_admin
WP_ADMIN_EMAIL=admin@limak.test
WP_SITE_TITLE=LIMAK Headless CMS

# --- phpMyAdmin ---
PMA_PORT=8081
